  <ItemGroup>
    <ProjectReference Include="..\GameTeam.Codegen\GameTeam.Codegen.csproj" />
  </ItemGroup>

  <!-- Fixtures OpenAPI mini copy ra output để test đọc bằng đường dẫn tương đối. -->
