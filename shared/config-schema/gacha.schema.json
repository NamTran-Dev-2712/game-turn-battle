{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-team/schema/gacha.schema.json",
  "title": "Gacha banner config",
  "description": "Banner + cấu trúc rate/pity (ADR-004). Bám ../../docs/gameplay/progression-and-economy.md. QUAN TRỌNG: schema định nghĩa CẤU TRÚC rate/pity, KHÔNG khoá giá trị (rate, pity threshold là tuning server-side).",
  "type": "object",
  "required": ["schema_version", "id", "pool", "rates"],
  "properties": {
    "schema_version": { "$ref": "https://game-team/schema/common.schema.json#/$defs/schema_version" },
    "id": { "$ref": "https://game-team/schema/common.schema.json#/$defs/gacha_id" },
    "pool": {
      "type": "array",
      "description": "Danh sách hero trong banner (gacha.pool -> hero id).",
      "minItems": 1,
      "items": { "$ref": "https://game-team/schema/common.schema.json#/$defs/hero_id" },
      "uniqueItems": true
    },
    "rates": {
      "type": "array",
      "description": "Cấu trúc tỉ trọng theo rarity. weight là integer cấu trúc — GIÁ TRỊ THẬT là tuning, không đặt ở schema.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rarity", "weight"],
        "properties": {
          "rarity": { "$ref": "https://game-team/schema/common.schema.json#/$defs/rarity" },
          "weight": { "$ref": "https://game-team/schema/common.schema.json#/$defs/combat_int" }
        },
        "additionalProperties": false
      }
    },
    "pity": {
      "type": "object",
      "description": "Cấu trúc pity (tuỳ chọn). threshold là integer cấu trúc — giá trị thật là tuning.",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "threshold": { "$ref": "https://game-team/schema/common.schema.json#/$defs/combat_int" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
