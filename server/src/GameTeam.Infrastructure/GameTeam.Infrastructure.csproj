<Project Sdk="Microsoft.NET.Sdk">
  <!-- Infrastructure: EF Core/PostgreSQL, Redis, JWT, Configuration Service, jobs.
       Hiện thực các port của Application (DIP). Phụ thuộc: Application, Domain. -->
  <ItemGroup>
    <ProjectReference Include="..\GameTeam.Application\GameTeam.Application.csproj" />
    <ProjectReference Include="..\GameTeam.Domain\GameTeam.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Design: chỉ dùng cho tooling migration (dev-time) — không propagate sang consumer. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- ILogger<T> cho RedisCacheService (graceful-degradation warning). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Dispatch domain event tại SaveChanges qua MediatR IPublisher (Phase 11). -->
    <PackageReference Include="MediatR" />
  </ItemGroup>
</Project>
