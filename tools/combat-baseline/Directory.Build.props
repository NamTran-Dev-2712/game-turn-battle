<Project>
  <!-- Thiet lap chung cho MOI project trong tools/combat-baseline/ (Phase 26).
       Bam sat server/Directory.Build.props + tools/config-validator/Directory.Build.props
       de giu dong nhat toolchain .NET 9. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Canh bao compiler chan build; canh bao analyzer khong chan (siet dan) —
         giong server/Directory.Build.props. -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1014</NoWarn>
  </PropertyGroup>
</Project>
