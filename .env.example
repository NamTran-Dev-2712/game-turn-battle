# Mẫu biến môi trường cho DEV LOCAL — copy thành `.env` và điền giá trị.
# KHÔNG commit `.env` (đã gitignore). Secret production dùng GitHub Environments
# (docs/deployment/ci-cd-pipeline.md §5). Đây chỉ là giá trị dev, không phải secret thật.

# ── PostgreSQL (deploy/compose/docker-compose.yml) ──
POSTGRES_USER=gameteam
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=gameteam
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── API ──
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# ── JWT (dev) — thay bằng khoá mạnh; production để ở secret store ──
JWT__ISSUER=game-team-dev
JWT__AUDIENCE=game-team-client
JWT__SIGNINGKEY=CHANGE_ME_DEV_ONLY_min_32_chars_secret
