# ─────────────────────────── Godot (client) ───────────────────────────
.godot/
client/.godot/
/android/
client/android/
export_presets.cfg.local
*.translation
# gdUnit4 JUnit/HTML reports sinh trong CI (ci-client.yml -rd reports) — không commit.
client/reports/
# Godot 4.x sinh file .uid cho mỗi script khi `--headless --import` (kể cả CI ci-client + codegen).
# Repo KHÔNG track .uid (quy ước từ Phase 03) → bỏ qua để import không tạo rác commit.
*.uid

# ─────────────────────────── .NET (server) ────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
TestResults/
*.trx
*.coverage
*.nupkg
artifacts/

# ─────────────────────────── Generated / build ────────────────────────
/build/*
!/build/README.md
/tmp/*
!/tmp/README.md
/shared/codegen/output/

# ─────────────────────────── Secrets / env ────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.p12
*.mobileprovision
appsettings.*.local.json
secrets.json

# ─────────────────────────── IDE / OS ─────────────────────────────────
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# VSCode: giữ cấu hình chia sẻ, bỏ cấu hình cá nhân
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ─────────────────── gdUnit4 addon (vendored, pin v6.2.0) ───────────────────
# Addon commit theo ADR-010. Nó có thư mục bin/ chứa CLI runner (GdUnitCmdTool.gd mà
# runtest.sh gọi) → rule .NET [Bb]in//[Oo]bj/[Rr]elease/... ở trên vô tình loại. Re-include
# TOÀN BỘ addon (last-match-wins). Phải un-exclude thư mục con trước, rồi tới nội dung.
!client/addons/gdUnit4/bin/
!client/addons/gdUnit4/**
